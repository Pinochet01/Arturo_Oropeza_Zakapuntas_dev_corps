#!/bin/bash
# kaspa-node — Toggle local Kaspa node on/off via systemd
# Usage: kaspa-node {start|stop|status|light|full|restart}

SVC="kaspad.service"
WALLET_CONFIG="$HOME/.kaspawallet/config.toml"
PUBLIC_NODES=("mainnet.kaspa.org:16110" "eu.mainnet.kaspa.org:16110")

start_kaspad() {
    if systemctl --user is-active --quiet "$SVC"; then
        echo "kaspad already running (systemd)"
        return 0
    fi
    echo "Starting kaspad via systemd..."
    systemctl --user start "$SVC"
    sleep 3
    if systemctl --user is-active --quiet "$SVC"; then
        PID=$(systemctl --user show -p MainPID --value "$SVC")
        RSS=$(ps -o rss= -p "$PID" 2>/dev/null | tr -d ' ')
        echo "kaspad started (PID: $PID, RAM: ${RSS}KB)"
        echo "  gRPC:   127.0.0.1:16110"
        echo "  wRPC:   127.0.0.1:17110 (Borsh), :18110 (JSON)"
    else
        echo "ERROR: kaspad failed to start. Check: journalctl --user -u kaspad -n 20"
        return 1
    fi
}

stop_kaspad() {
    if ! systemctl --user is-active --quiet "$SVC" 2>/dev/null; then
        echo "kaspad not running"
        return 0
    fi
    echo "Stopping kaspad..."
    systemctl --user stop --timeout=15 "$SVC" 2>/dev/null
    sleep 2
    if systemctl --user is-active --quiet "$SVC" 2>/dev/null; then
        echo "Force killing..."
        systemctl --user kill -s SIGKILL "$SVC" 2>/dev/null
        sleep 1
    fi
    echo "kaspad stopped"
}

status_kaspad() {
    if systemctl --user is-active --quiet "$SVC" 2>/dev/null; then
        PID=$(systemctl --user show -p MainPID --value "$SVC")
        RSS=$(ps -o rss= -p "$PID" 2>/dev/null | tr -d ' ')
        echo "kaspad: RUNNING (PID: $PID, RAM: ${RSS}KB, max: 512MB)"
        echo "  gRPC: 127.0.0.1:16110"
        echo "  wRPC: 127.0.0.1:17110, 127.0.0.1:18110"
        echo "  P2P:  0.0.0.0:16111"
    else
        echo "kaspad: STOPPED"
    fi
    echo ""
    echo "Wallet config:"
    grep -E "address|network" "$WALLET_CONFIG" 2>/dev/null || echo "  No config"
}

light_mode() {
    stop_kaspad 2>/dev/null
    echo "Switching to LIGHT mode (public RPC, 0 RAM)..."
    echo "  Wallet uses: ${PUBLIC_NODES[0]}"
    echo "  No local node. Saves 200-500MB RAM."
    echo "  Done."
}

full_mode() {
    echo "Switching to FULL mode (local node, max 512MB RAM)..."
    start_kaspad
    echo "  Wallet uses: 127.0.0.1:16110"
    echo "  Done."
}

case "${1:-status}" in
    start|up|on)
        start_kaspad
        ;;
    stop|down|off)
        stop_kaspad
        ;;
    status|st)
        status_kaspad
        ;;
    light|lite)
        light_mode
        ;;
    full|node)
        full_mode
        ;;
    restart)
        systemctl --user restart "$SVC"
        sleep 2
        status_kaspad
        ;;
    *)
        echo "Usage: kaspa-node {start|stop|status|light|full|restart}"
        echo ""
        echo "  light  — Public RPC, 0 local RAM (default, recommended)"
        echo "  full   — Local kaspad node, max 512MB RAM"
        echo "  status — Show node status + wallet config"
        exit 1
        ;;
esac

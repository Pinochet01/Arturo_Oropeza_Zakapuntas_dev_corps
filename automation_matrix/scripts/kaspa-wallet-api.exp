#!/usr/bin/env expect
# kaspa-wallet-api.exp — Non-interactive expect wrapper for rusty-kaspa wallet CLI
# Usage: ./kaspa-wallet-api.exp <command> [args...]
# Connects to public Kaspa mainnet nodes (no local kaspad required)

set timeout 45
set wallet_bin [lindex $argv 0]
set command [lindex $argv 1]
set arg1 [lindex $argv 2]
set arg2 [lindex $argv 3]
set password "Electrosantander.03"

# Public Kaspa gRPC endpoints (no local node needed)
set kaspa_nodes {
    "mainnet.kaspa.org:16110"
    "eu.mainnet.kaspa.org:16110"
    "na.mainnet.kaspa.org:16110"
}

log_user 0
spawn $wallet_bin

expect -re {\$ $}

# --- Phase 1: connect to a public node ---
set node_found 0
foreach node $kaspa_nodes {
    send "server $node\r"
    expect -re {Connected|already connected|error|timeout} {
        if {\$expect_out(0,string) ne "error" && \$expect_out(0,string) ne "timeout"} {
            set node_found 1
            break
        }
    }
}
expect -re {\$ $}

send "network mainnet\r"
expect -re {\$ $}

send "connect\r"
expect -re {\$ $}

# --- Phase 2: open wallet ---
send "open kaspa\r"
expect "password:"
send "$password\r"
expect -re {\$ $}

log_user 1

if {$command eq "balance" || $command eq "list" || $command eq "utxos"} {
    send "list\r"
    expect -re {\$ $}
} elseif {$command eq "new-address"} {
    send "address\r"
    expect -re {\$ $}
} elseif {$command eq "address"} {
    send "address\r"
    expect -re {\$ $}
}

log_user 0
send "exit\r"
expect eof

# ══════════════════════════════════════════════════════════════════════════════
#  Caddyfile — Automation Matrix · Delphos Agency
#  PRODUCCIÓN: Let's Encrypt automático
#
#  Variables de entorno requeridas en .env:
#    DOMAIN=matrix.delphos.mx          (o el subdominio que uses)
#    CF_API_TOKEN=<cloudflare_token>   (si usas DNS-01 challenge)
#
#  Modos:
#    1. HTTP-01  → el dominio apunta directo a esta IP pública, puerto 80 abierto
#    2. DNS-01   → detrás de NAT/zrok, usa Cloudflare API (recomendado aquí)
# ══════════════════════════════════════════════════════════════════════════════

{
    # Email para notificaciones de expiración de Let's Encrypt
    email hola@delphos.mx

    # ACME server (producción). Para pruebas usa:
    # acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
    acme_ca https://acme-v02.api.letsencrypt.org/directory

    # Almacena los certs en el directorio del proyecto
    storage file_system {
        root /home/arturo_oropeza/automation_matrix/ssl/caddy
    }

    # Logs globales
    log {
        output file /home/arturo_oropeza/automation_matrix/ssl/caddy/caddy.log {
            roll_size 10mb
            roll_keep 5
        }
        level INFO
    }
}

# ── PRODUCCIÓN: dominio real con TLS automático ────────────────────────────
{$DOMAIN:matrix.delphos.mx} {

    # TLS automático — Caddy elige HTTP-01 si el puerto 80 es alcanzable,
    # o DNS-01 si CF_API_TOKEN está presente (recomendado con zrok/NAT).
    tls {
        dns cloudflare {$CF_API_TOKEN}
    }

    # Headers de seguridad
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        X-XSS-Protection          "1; mode=block"
        Referrer-Policy           "strict-origin-when-cross-origin"
        -Server
    }

    # Rate limiting básico (requiere caddy-ratelimit plugin)
    # rate_limit {
    #     zone api {
    #         key {remote_host}
    #         events 100
    #         window 1m
    #     }
    # }

    # Logging por request
    log {
        output file /home/arturo_oropeza/automation_matrix/ssl/caddy/access.log {
            roll_size 20mb
            roll_keep 7
        }
        format json
    }

    # Health check sin proxy (respuesta directa)
    respond /ping 200 {
        body "pong"
        close
    }

    # Proxy al servidor Express
    reverse_proxy localhost:8080 {
        header_up   X-Real-IP        {remote_host}
        header_up   X-Forwarded-For  {remote_host}
        header_up   X-Forwarded-Proto https
        header_down -Server

        # Timeouts
        transport http {
            dial_timeout       5s
            response_header_timeout 30s
        }

        # Health check hacia Express
        health_uri    /health
        health_interval 15s
        health_timeout  5s
    }
}

# ── HTTP → HTTPS redirect ───────────────────────────────────────────────────
http://{$DOMAIN:matrix.delphos.mx} {
    redir https://{host}{uri} permanent
}
